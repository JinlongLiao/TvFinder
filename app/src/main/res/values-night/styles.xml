<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:colorBackground">@color/page_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:alertDialogTheme">@style/TvDialogTheme</item>
    </style>
    <style name="TvDialogThemeBase" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="TvDialogTheme" parent="TvDialogThemeBase" />
</resources>
